# Copy this file to .env and fill in your values (local development only).
# .env is git-ignored. NEVER commit real secrets. In the cloud, set these in the
# Render dashboard instead (see docs/DEPLOYMENT.md).

# ─── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Example (local Postgres): postgresql://postgres:password@localhost:5432/rfid_dashboard
# Example (Neon):           postgresql://user:password@ep-xxxx.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:password@localhost:5432/rfid_dashboard

# ─── Dashboard login ──────────────────────────────────────────────────────────
# Defaults to admin / admin locally. In production (NODE_ENV=production) the
# server refuses to start unless ADMIN_PASSWORD is set, 10+ chars and not "admin".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ─── Device authentication ────────────────────────────────────────────────────
# Pre-shared secret the ESP32 sends in its auth_request (firmware DEVICE_AUTH_KEY).
# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
DEVICE_AUTH_SECRET=change-me

# ─── Server ───────────────────────────────────────────────────────────────────
# API server port (Render injects PORT automatically)
PORT=8080

# Set to false in the cloud: disables raw TCP :5001, UDP discovery and mDNS.
# Controllers then connect through wss://<host>/api/device-ws instead.
# ENABLE_LAN_SERVICES=true

# ─── LAN mode only (ENABLE_LAN_SERVICES=true) ─────────────────────────────────
TCP_PORT=5001
UDP_DISCOVERY_PORT=5002
APP_HOSTNAME=rfid-app.local

# ─── Optional ─────────────────────────────────────────────────────────────────
# Force the Secure flag on the session cookie (defaults to true in production).
# COOKIE_SECURE=true
# Extra browser origins allowed to call the API with cookies (comma-separated).
# Not needed when the dashboard is served by this same server.
# CORS_ORIGINS=https://dashboard.example.com
# Frontend dev server port
# VITE_PORT=3000
